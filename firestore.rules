rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole() {
      return isSignedIn() && userDoc().data.role in ['duena', 'admin'];
    }

    function isDuena() {
      return isSignedIn() && userDoc().data.role == 'duena';
    }

    // Productos: lectura pública solo de los visibles; cualquier admin/duena
    // puede leer todo (panel) y escribir.
    match /products/{productId} {
      allow read: if resource.data.visible == true || hasRole();
      allow create, update, delete: if hasRole();
    }

    // Categorías: lectura pública total, escritura solo admin/duena.
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if hasRole();
    }

    // Usuarios/roles: cada usuario puede leer su propio documento (para saber
    // su rol al iniciar sesión); el resto de la gestión es solo de la dueña.
    // La creación/eliminación real de cuentas se hace desde /api con el Admin
    // SDK, pero las reglas igual protegen lecturas y ediciones directas.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isDuena());
      allow write: if isDuena();
    }
  }
}
