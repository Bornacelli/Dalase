# ---- Firebase (proyecto web) ----
# Se obtienen en: Firebase Console > Configuración del proyecto > Tus apps > Config SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Cloudinary (subida desde el navegador) ----
# Cloud name: Cloudinary Console > Dashboard
VITE_CLOUDINARY_CLOUD_NAME=
# Upload preset "unsigned" creado en Settings > Upload > Upload presets
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---- WhatsApp ----
# Número de la tienda en formato internacional sin "+" ni espacios, ej: 573001234567
VITE_WHATSAPP_NUMBER=

# ================================================================
# Variables SOLO para las funciones serverless de /api (Vercel).
# NO llevan prefijo VITE_ porque nunca deben llegar al navegador.
# ================================================================

# Cuenta de servicio de Firebase (Firebase Console > Configuración del proyecto
# > Cuentas de servicio > Generar nueva clave privada). Del JSON descargado:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Pega la private_key tal cual, conservando los \n
FIREBASE_PRIVATE_KEY=

# Cloudinary Console > Dashboard > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
